{
  "name": "civicfix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CivicFix — Hackathon civic issue reporting and tracking platform",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "seed:admin": "npm --prefix server run db:seed",
    "test:backend": "node server/src/scripts/verify-backend.js",
    "test:e2e": "node server/src/scripts/test-complete-17-steps.js",
    "install:all": "npm --prefix server install && npm --prefix client install && npm --prefix frontend install"
  },
  "keywords": ["civic-tech", "react", "express", "postgresql", "hackathon"],
  "author": "CivicFix Team",
  "license": "MIT"
}
